{
  "manifest_version": 3,
  "name": "Guilty if Charged",
  "version": "0.1.0",
  "description": "Puts your online shopping on trial before you check out.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.ca/*",
        "http://localhost/*"
      ],
      "js": [
        "src/script.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Guilty if Charged",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
